# Odlar Yurdu University — Academic Management Portal: переменные окружения для docker compose.
# Скопируйте в .env и задайте СВОИ значения (start-demo.bat делает это автоматически).
# Секреты — не коммитить (.env в .gitignore).

POSTGRES_PASSWORD=change_me_db_password
# минимум 32 случайных символа каждый (например: openssl rand -hex 32)
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars

# ── Профиль ЛОКАЛЬНОГО ДЕМО (http://localhost). Для реального развёртывания:
#    DEMO_MODE=false, ALLOW_DEMO_IN_PRODUCTION=false, COOKIE_SECURE=true, ALLOW_INSECURE_COOKIES=false,
#    EXAM_ALLOWED_NETWORKS=<CIDR сети компьютерных классов> — иначе API откажется стартовать.
# Демо-режим: true = пустая база заполняется демо-данными, доступен сброс владельцем, демо-экзамены
DEMO_MODE=true
# Контейнер работает с NODE_ENV=production: демо в нём разрешается только этим явным флагом
ALLOW_DEMO_IN_PRODUCTION=true
# Секрет владельца для POST /api/v1/demo/reset и `npm run demo:reset` (>= 16 символов; пусто = сброс по HTTP отключён)
DEMO_RESET_TOKEN=

# Публичный адрес API, если фронтенд и API на разных доменах (иначе пусто)
AP_API_BASE=
FRONTEND_ORIGIN=http://localhost:3000
# http://localhost не поддерживает Secure-cookie; разрешено только явным флагом
COOKIE_SECURE=false
ALLOW_INSECURE_COOKIES=true
COOKIE_SAMESITE=strict
# Необязательно: ключ Anthropic для AI-ассистента (без ключа работает заглушка)
ANTHROPIC_API_KEY=
# Exam kiosks may only run from these networks (CIDR, comma separated). Required in production unless DEMO_MODE
EXAM_ALLOWED_NETWORKS=
