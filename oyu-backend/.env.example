# Academic Portal API — локальная разработка без Docker (npm run start:dev).
NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://ap:change_me_db_password@localhost:5432/ap?schema=public

# минимум 32 символа каждый — задайте свои значения
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173
COOKIE_SAMESITE=strict
COOKIE_SECURE=false

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

# Public demo
DEMO_MODE=true
# Only relevant when NODE_ENV=production: demo / insecure cookies must be opted into explicitly
ALLOW_DEMO_IN_PRODUCTION=false
ALLOW_INSECURE_COOKIES=false
DEMO_RESET_TOKEN=

# Необязательно: без ключа AI-ассистент работает в режиме заглушки
ANTHROPIC_API_KEY=
LOG_LEVEL=debug
# Exam Management System: sub-networks (CIDR, comma separated) allowed for exam kiosks. Empty = not enforced (workstation key + one-time token still required)
EXAM_ALLOWED_NETWORKS=
